# =============================================================================
# Resend Email Service Configuration
# =============================================================================
# Get your API key from the Resend Dashboard: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Destination inbox for inbound project enquiries from the contact form
CONTACT_RECEIVER_EMAIL=motivetechnologies1@gmail.com

# Sender address (From)
# For initial testing before domain verification, use Resend's default sender:
# 'Motive Technologies <onboarding@resend.dev>'
# After verifying your domain in Resend, switch to your domain, e.g.:
# 'Motive Technologies <contact@motivetechnologies.in>'
RESEND_FROM_EMAIL=Motive Technologies <onboarding@resend.dev>

